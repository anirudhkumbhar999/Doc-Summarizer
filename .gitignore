# ------------------------------
# Deployment-safe Git ignore
# Keep source + config in git.
# Ignore local secrets/runtime/cache/build outputs.
# ------------------------------

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build and coverage artifacts
dist/
build/
coverage/
*.tsbuildinfo
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.cache/
.turbo/

# Local runtime/generated data
chroma-data/
backend/uploads/
uploads/
tmp/
temp/
*.pid

# Local environment/secret files
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
